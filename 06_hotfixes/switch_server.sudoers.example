# Narrow NOPASSWD sudoers entry so driver.sh can flip the STT / TTS servers
# unattended WITHOUT granting blanket docker / root access. It permits running only
# switch_server.sh (with any arguments) as root, nothing else.
#
# Install with (validates syntax before saving; never edit /etc/sudoers directly):
#   sudo visudo -f /etc/sudoers.d/crispasr-switch
# then paste the line below with the two TODOs filled in.
#
# TODO: replace <youruser> with your login name and <abs-path> with the absolute path
# to switch_server.sh on THIS machine (both are host-specific, so they live only in
# /etc/sudoers.d on your box, never committed):
#
# <youruser> ALL=(root) NOPASSWD: <abs-path>/switch_server.sh
#
# Example shape (do not commit real values):
#   alice ALL=(root) NOPASSWD: /home/alice/.../06_hotfixes/switch_server.sh
#
# Note: switch_server.sh reads the compose path from CRISPASR_COMPOSE or its 2nd
# argument; driver.sh passes it as the 2nd argument, so no env_keep / SETENV is needed
# in this entry.
#
# This file was written with Claude Code.
